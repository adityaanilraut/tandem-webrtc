{
  "name": "tandem-webrtc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n signal,web -c blue,green \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "public": "npm run build && tsx scripts/start-public.ts",
    "start": "tsx server/production.ts",
    "setup:https": "tsx scripts/setup-https.ts",
    "setup:iphone": "tsx scripts/serve-iphone-setup.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "npm run build && tsx scripts/test-mesh.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "ws": "8.23.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "playwright": "^1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
