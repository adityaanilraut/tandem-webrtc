# No settings are required for npm run public (HTTPS + direct/STUN calls).
# Copy this file to .env.local to add an optional TURN relay.
# Server settings and secrets must NEVER use the VITE_ prefix.

STUN_URL=stun:stun.l.google.com:19302

# Option A: Cloudflare Realtime TURN. Create a TURN key in the Cloudflare dashboard.
# The server exchanges these secrets for temporary browser credentials.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Option B: another managed TURN service, including Metered's free tier.
# Use the TURN host, username and password supplied by your provider.
# For public calls prefer an option that issues short-lived credentials.
# Prefer including TURN/TLS on TCP 443 for restrictive networks.
# TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_PASSWORD=

# Option C: coturn with use-auth-secret. Use this instead of TURN_USERNAME/PASSWORD.
# TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:443?transport=tcp
# TURN_SECRET=

# Set to relay temporarily to verify that a configured TURN service works.
ICE_TRANSPORT_POLICY=all

# Only for npm start behind a permanent HTTPS reverse proxy or named tunnel.
# PUBLIC_ORIGIN=https://call.example.com
# PORT=3002
# HOST=127.0.0.1
# Set only behind a trusted proxy that overwrites this header.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Optional legacy LAN development (still needs device certificate trust).
# LAN_HOST=192.168.1.25
